  <!-- ===== Linker Hand O6 (right) mounted on the wrist =====
       xyz = centre of the Rwrist1_Link distal flange (local z = -65.6 mm)
       rpy = (pi, 0, gamma): turns the hand to point along the wrist -Z.
       gamma (the 3rd value) swings the palm about the mounting axis:
         0        palm faces  +X of Rwrist1_Link
         1.5708   palm faces  +Y
         3.1416   palm faces  -X
        -1.5708   palm faces  -Y
       Adjust xyz/rpy here if the real bracket differs. -->
  <joint
    name="Rwrist1_to_hand"
    type="fixed">
    <origin
      xyz="-0.02132 5e-05 -0.0656"
      rpy="3.141592653589793 0.0 1.5707963267948966" />
    <parent
      link="Rwrist1_Link" />
    <child
      link="rh_hand_base_link" />
  </joint>
