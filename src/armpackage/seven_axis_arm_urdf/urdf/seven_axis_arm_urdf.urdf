<?xml version="1.0" encoding="utf-8"?>
<!-- Dual 7-axis arm + 2x Linker Hand O6 on the stand (7-axis arm assembly with stand). -->
<robot
  name="seven_axis_arm_urdf">
  <!-- base_link = the stand.  Origin at the midpoint between the two
       arm mounts, axes REP-103: X forward, Y left, Z up.  The stand mesh
       keeps its SolidWorks frame; the visual/collision origin below places
       it.  Floor is at z = -1.202000019369 m. -->
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="-0.030092731198 6.335e-09 -0.704152911999"
        rpy="0 0 0" />
      <mass
        value="7.911" />
      <inertia
        ixx="2.608038831697"
        ixy="3.35e-10"
        ixz="0.009058161652"
        iyy="2.23398890312"
        iyz="-2.4671e-08"
        izz="0.507645384131" />
    </inertial>
    <visual>
      <origin
        xyz="-1.0285 0.021020174026 -0.4024896"
        rpy="0 0 1.570796326795" />
      <geometry>
        <mesh
          filename="package://seven_axis_arm_urdf/meshes/stand.STL" />
      </geometry>
      <material
        name="stand">
        <color
          rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="-1.0285 0.021020174026 -0.4024896"
        rpy="0 0 1.570796326795" />
      <geometry>
        <mesh
          filename="package://seven_axis_arm_urdf/meshes/stand.STL" />
      </geometry>
    </collision>
  </link>
  <!-- Arm mounts.  Right arm registered onto the shoulder XM540 in the
       SW2URDF export of the stand assembly dated 2026-10-29 (residual 0.06 um),
       35 mm further forward than the earlier reference motor; left arm is its
       mirror across the stand centre plane.  base_link stays midway between the
       two mounts, so these joints are unchanged and the stand moved instead.
       Same joint values on both arms give mirror-symmetric poses. -->
  <joint
    name="stand_to_Rarm"
    type="fixed">
    <origin
      xyz="0 -0.145400025974 0"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="Rarm_base_link" />
  </joint>
  <joint
    name="stand_to_Larm"
    type="fixed">
    <origin
      xyz="0 0.145400025974 0"
      rpy="0 0 0" />
