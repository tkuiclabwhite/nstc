<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="seven_axis_arm_urdf_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- By default, set up controllers for simulation. This won't work on real hardware -->
                <plugin>mock_components/GenericSystem</plugin>
            </hardware>
            <joint name="RshoulderJoint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['RshoulderJoint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="RarmJoint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['RarmJoint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Rarm1Joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Rarm1Joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="RforarmJoint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['RforarmJoint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Rforarm1Joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Rforarm1Joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="RwristJoint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['RwristJoint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Rwrist1Joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Rwrist1Joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="LshoulderJoint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['LshoulderJoint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="LarmJoint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['LarmJoint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Larm1Joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Larm1Joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="LforarmJoint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['LforarmJoint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Lforarm1Joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Lforarm1Joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="LwristJoint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['LwristJoint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Lwrist1Joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Lwrist1Joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
